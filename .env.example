# Copy this file to ".env" and fill in your own Supabase project values.
#   cp .env.example .env
#
# Find these in your Supabase dashboard:
#   Project Settings -> API
#   - "Project URL"          -> VITE_SUPABASE_URL
#   - "Project API keys" -> "anon" "public" -> VITE_SUPABASE_ANON_KEY
#
# The anon/public key is safe to ship in a browser app (it only allows what
# your Row Level Security policies allow). NEVER put the "service_role" key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push (optional but needed for background notifications).
# The PUBLIC key is safe in the browser. Generate a pair with:
#   npx web-push generate-vapid-keys
# Put the public key here (and in Vercel env vars); keep the private key as a
# Supabase Edge Function secret (see supabase/functions/send-push/README.md).
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
